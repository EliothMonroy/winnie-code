{
  "title": "Search in Linked List",
  "difficulty": "Easy",
  "method": {
    "name": "search",
    "params": [
      { "name": "head", "type": "ListNode?" },
      { "name": "target", "type": "Int" }
    ],
    "returns": "Int"
  },
  "tests": [
    { "input": ["[1,2,3]", "2"], "expected": "1" },
    { "input": ["[1,2,3]", "4"], "expected": "0" },
    { "input": ["[]", "1"], "expected": "0" },
    { "input": ["[7]", "7"], "expected": "1" },
    { "input": ["[7]", "3"], "expected": "0" },
    { "input": ["[1,2,3]", "1"], "expected": "1" },
    { "input": ["[1,2,3]", "3"], "expected": "1" },
    { "input": ["[5,5,5]", "5"], "expected": "1" },
    { "input": ["[0,1,2]", "0"], "expected": "1" },
    { "input": ["[-1,-2,-3]", "-3"], "expected": "1" },
    { "input": ["[-1,-2,-3]", "3"], "expected": "0" },
    { "input": ["[2147483647,-2147483648]", "-2147483648"], "expected": "1" }
  ]
}
