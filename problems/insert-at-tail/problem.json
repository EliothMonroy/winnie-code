{
  "title": "Insert at Tail of Linked List",
  "difficulty": "Easy",
  "method": {
    "name": "insertAtTail",
    "params": [
      { "name": "head", "type": "ListNode?" },
      { "name": "value", "type": "Int" }
    ],
    "returns": "ListNode?"
  },
  "tests": [
    { "input": ["[1,2,3]", "4"], "expected": "[1,2,3,4]" },
    { "input": ["[]", "5"], "expected": "[5]" },
    { "input": ["[7]", "7"], "expected": "[7,7]" },
    { "input": ["[1,2]", "0"], "expected": "[1,2,0]" },
    { "input": ["[3,2,1]", "9"], "expected": "[3,2,1,9]" },
    { "input": ["[-1,-2]", "-3"], "expected": "[-1,-2,-3]" },
    { "input": ["[1,1,1]", "1"], "expected": "[1,1,1,1]" },
    { "input": ["[0]", "2147483647"], "expected": "[0,2147483647]" },
    { "input": ["[10,20,30,40,50,60,70,80,90]", "-2147483648"], "expected": "[10,20,30,40,50,60,70,80,90,-2147483648]" }
  ]
}
