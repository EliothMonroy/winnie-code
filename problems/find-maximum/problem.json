{
  "title": "Find Maximum",
  "difficulty": "Easy",
  "method": {
    "name": "findMax",
    "params": [{ "name": "nums", "type": "IntArray" }],
    "returns": "Int"
  },
  "tests": [
    { "input": ["[3,1,4,1,5]"], "expected": "5" },
    { "input": ["[-10,-3,-7,-1]"], "expected": "-1" },
    { "input": ["[42]"], "expected": "42" },
    { "input": ["[9,2,7,1]"], "expected": "9" },
    { "input": ["[7,7,7,7]"], "expected": "7" },
    { "input": ["[-5,0,-1]"], "expected": "0" },
    { "input": ["[-2147483648]"], "expected": "-2147483648" },
    { "input": ["[-2147483648,2147483647,0]"], "expected": "2147483647" }
  ]
}
