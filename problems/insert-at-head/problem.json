{
  "title": "Insert at Head of Linked List",
  "difficulty": "Easy",
  "method": {
    "name": "insertAtHead",
    "params": [
      { "name": "head", "type": "ListNode?" },
      { "name": "value", "type": "Int" }
    ],
    "returns": "ListNode?"
  },
  "tests": [
    { "input": ["[1,2,3]", "0"], "expected": "[0,1,2,3]" },
    { "input": ["[]", "5"], "expected": "[5]" },
    { "input": ["[7]", "7"], "expected": "[7,7]" },
    { "input": ["[2,3]", "1"], "expected": "[1,2,3]" },
    { "input": ["[3,2,1]", "9"], "expected": "[9,3,2,1]" },
    { "input": ["[-1,-2]", "-3"], "expected": "[-3,-1,-2]" },
    { "input": ["[1,1,1]", "1"], "expected": "[1,1,1,1]" },
    { "input": ["[0]", "-2147483648"], "expected": "[-2147483648,0]" },
    { "input": ["[10,20,30,40,50,60,70,80,90]", "2147483647"], "expected": "[2147483647,10,20,30,40,50,60,70,80,90]" }
  ]
}
