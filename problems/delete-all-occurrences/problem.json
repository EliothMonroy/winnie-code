{
  "title": "Delete All Occurrences from Linked List",
  "difficulty": "Easy",
  "method": {
    "name": "deleteAllOccurrences",
    "params": [
      { "name": "head", "type": "ListNode?" },
      { "name": "value", "type": "Int" }
    ],
    "returns": "ListNode?"
  },
  "tests": [
    { "input": ["[1,2,3,2,4]", "2"], "expected": "[1,3,4]" },
    { "input": ["[1,1,1]", "1"], "expected": "[]" },
    { "input": ["[1,2,3]", "4"], "expected": "[1,2,3]" },
    { "input": ["[]", "1"], "expected": "[]" },
    { "input": ["[7]", "7"], "expected": "[]" },
    { "input": ["[7]", "3"], "expected": "[7]" },
    { "input": ["[2,2,1]", "2"], "expected": "[1]" },
    { "input": ["[1,2,2]", "2"], "expected": "[1]" },
    { "input": ["[2,1,2]", "2"], "expected": "[1]" },
    { "input": ["[1,2,2,2,3]", "2"], "expected": "[1,3]" },
    { "input": ["[6,6,1,6,6,2,6]", "6"], "expected": "[1,2]" },
    { "input": ["[0,0,1]", "0"], "expected": "[1]" },
    { "input": ["[-1,0,-1]", "-1"], "expected": "[0]" }
  ]
}
