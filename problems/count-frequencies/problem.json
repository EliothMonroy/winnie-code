{
  "title": "Count Frequencies",
  "difficulty": "Easy",
  "method": {
    "name": "countFrequencies",
    "params": [{ "name": "arr", "type": "IntArray" }],
    "returns": "HashMap<Int, Int>"
  },
  "tests": [
    { "input": ["[1,2,2,3,3,3]"], "expected": "{1: 1, 2: 2, 3: 3}" },
    { "input": ["[5,5,5,5]"], "expected": "{5: 4}" },
    { "input": ["[1,2,3,4]"], "expected": "{1: 1, 2: 1, 3: 1, 4: 1}" },
    { "input": ["[]"], "expected": "{}" },
    { "input": ["[7]"], "expected": "{7: 1}" },
    { "input": ["[0,0,0]"], "expected": "{0: 3}" },
    { "input": ["[3,1,3,1,3]"], "expected": "{1: 2, 3: 3}" },
    { "input": ["[-1,-1,0,1]"], "expected": "{-1: 2, 0: 1, 1: 1}" },
    { "input": ["[10,9,10,9,10,100]"], "expected": "{9: 2, 10: 3, 100: 1}" },
    { "input": ["[-2147483648,2147483647,-2147483648]"], "expected": "{-2147483648: 2, 2147483647: 1}" }
  ]
}
