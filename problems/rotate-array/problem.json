{
  "title": "Rotate Array",
  "difficulty": "Easy",
  "method": {
    "name": "rotate",
    "params": [
      { "name": "nums", "type": "IntArray" },
      { "name": "k", "type": "Int" }
    ],
    "returns": "IntArray"
  },
  "tests": [
    { "input": ["[1,2,3,4,5]", "2"], "expected": "[4,5,1,2,3]" },
    { "input": ["[1,2,3]", "4"], "expected": "[3,1,2]" },
    { "input": ["[1,2,3,4]", "0"], "expected": "[1,2,3,4]" },
    { "input": ["[]", "3"], "expected": "[]" },
    { "input": ["[1]", "5"], "expected": "[1]" },
    { "input": ["[1,2,3]", "3"], "expected": "[1,2,3]" },
    { "input": ["[1,2,3,4,5,6,7]", "3"], "expected": "[5,6,7,1,2,3,4]" },
    { "input": ["[-1,-100,3,99]", "2"], "expected": "[3,99,-1,-100]" },
    { "input": ["[1,2,3,4,5]", "7"], "expected": "[4,5,1,2,3]" },
    { "input": ["[1,2]", "2147483647"], "expected": "[2,1]" }
  ]
}
