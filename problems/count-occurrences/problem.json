{
  "title": "Count Occurrences",
  "difficulty": "Easy",
  "method": {
    "name": "countOccurrences",
    "params": [
      { "name": "nums", "type": "IntArray" },
      { "name": "target", "type": "Int" }
    ],
    "returns": "Int"
  },
  "tests": [
    { "input": ["[1,2,3,2,4,2]", "2"], "expected": "3" },
    { "input": ["[5,5,5,5]", "5"], "expected": "4" },
    { "input": ["[1,2,3]", "7"], "expected": "0" },
    { "input": ["[]", "1"], "expected": "0" },
    { "input": ["[7]", "7"], "expected": "1" },
    { "input": ["[7]", "3"], "expected": "0" },
    { "input": ["[4,1,1,4]", "4"], "expected": "2" },
    { "input": ["[-1,0,-1,1,-1]", "-1"], "expected": "3" },
    { "input": ["[-2147483648,2147483647,-2147483648]", "-2147483648"], "expected": "2" }
  ]
}
