{
  "title": "Simulate Print Queue",
  "difficulty": "Easy",
  "method": {
    "name": "simulatePrintQueue",
    "params": [{ "name": "jobs", "type": "List<Int>" }],
    "returns": "List<Int>"
  },
  "tests": [
    { "input": ["[5,3,8,2]"], "expected": "[5,8,16,18]" },
    { "input": ["[10]"], "expected": "[10]" },
    { "input": ["[1,1,1,1]"], "expected": "[1,2,3,4]" },
    { "input": ["[]"], "expected": "[]" },
    { "input": ["[2,2]"], "expected": "[2,4]" },
    { "input": ["[100,1,100]"], "expected": "[100,101,201]" },
    { "input": ["[3,1,4,1,5,9,2,6]"], "expected": "[3,4,8,9,14,23,25,31]" },
    { "input": ["[7,7,7,7,7,7,7,7,7,7]"], "expected": "[7,14,21,28,35,42,49,56,63,70]" },
    { "input": ["[1000000000,1000000000]"], "expected": "[1000000000,2000000000]" }
  ]
}
